# Pyro API base URL — shared by all debit service token managers (FancySale / SimSwap / ESIM)
PYRO_BASE_URL=https://IP:PORT
# Optional. HTTP timeout in seconds for Pyro API calls.
PYRO_REQUEST_TIMEOUT_SECONDS=30.0

# Oracle DB — used by debit service adapters (CAF tables)
ORACLE_USER=CAF_ADMIN
ORACLE_PASSWORD=your_oracle_password
ORACLE_DSN=hostname:1521/service_name

# PostgreSQL DB — debit_txn_log, oracle_writeback_outbox
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=your_db_name
PG_USER=your_pg_user
PG_PASSWORD=your_pg_password
PG_MIN_CONN=2
PG_MAX_CONN=10

# Deployment
ROOT_PATH=/smpyro
ADMIN_API_KEY=change_this_long_random_admin_key

# Scheduler
ENABLE_SCHEDULER=true
RUN_DEBIT_ON_STARTUP=false
RUN_CLEANUP_ON_STARTUP=true

# FancySale debit service
FANCYSALE_API_KEY=your_fancysale_api_key
FANCYSALE_LOGIN_ID=your_fancysale_login_id
FANCYSALE_PASSWORD=your_fancysale_password
FANCYSALE_SECRET_KEY=your_fancysale_3des_secret
FANCYSALE_ENABLED=true
FANCYSALE_BATCH_SIZE=200
FANCYSALE_INTERVAL_MINUTES=30
FANCYSALE_STUCK_MINUTES=10

# SimSwap debit service: adapter is not implemented yet. Keep disabled.
SIMSWAP_API_KEY=
SIMSWAP_LOGIN_ID=
SIMSWAP_PASSWORD=
SIMSWAP_SECRET_KEY=
SIMSWAP_ENABLED=false

# ESIM debit service: adapter is not implemented yet. Keep disabled.
ESIM_API_KEY=
ESIM_LOGIN_ID=
ESIM_PASSWORD=
ESIM_SECRET_KEY=
ESIM_ENABLED=false

# Disabled debit credentials are skipped during auth on startup by default.
VALIDATE_DISABLED_DEBIT_CREDENTIALS=false
